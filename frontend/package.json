{
  "name": "dealdesk-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "DealDesk v2 前端：TypeScript + React + Vite，vertciti DNA 组件库；构建产物输出到 ../static/app（入库，部署零构建）",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "${PYTHON:-../.venv/bin/python} ../tools/export_openapi.py openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.21.0",
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
