# DealDesk configuration reference. Copy to `.env` (git-ignored) and fill in.
# Every variable below is read by the code (app/ and tools/); all are optional
# unless marked REQUIRED-FOR. NEVER commit real values.

# --- Storage -----------------------------------------------------------
# Postgres connection URL. Unset = SQLite (local development).
DATABASE_URL=
# SQLite file path when DATABASE_URL is unset (default: ./dealdesk.db).
DEALDESK_DB=

# --- Auth / sessions ---------------------------------------------------
# on|1|true|yes enables authentication (default: off).
DEALDESK_AUTH=off
# Also protect legacy /api/v1 routes when auth is on (1|on|true).
DEALDESK_AUTH_PROTECT_V1=
# Allow bearer-token login (on|1|true|yes).
DEALDESK_TOKEN_LOGIN_ENABLED=
# Secret used to sign session cookies (falls back to GOOGLE_CLIENT_SECRET).
DEALDESK_SESSION_SECRET=
# Session cookie Secure flag; set 0 only for plain-http local dev (default 1).
DEALDESK_SESSION_COOKIE_SECURE=1

# Google OAuth sign-in (existing users only; no public registration).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Hardening / observability ----------------------------------------
# Trust X-Forwarded-For (set 1 only behind a trusted proxy).
DEALDESK_TRUST_PROXY=
# Failed-auth rate limit: attempts per window (seconds).
DEALDESK_AUTH_FAIL_LIMIT=20
DEALDESK_AUTH_FAIL_WINDOW=300
# Max request body in MB.
DEALDESK_MAX_BODY_MB=32
# Log level (DEBUG|INFO|WARNING|ERROR).
DEALDESK_LOG_LEVEL=INFO
# Optional webhook URL that receives server-error notifications.
DEALDESK_ERROR_WEBHOOK=

# --- Data providers ----------------------------------------------------
# RentCast rent data API key.
RENTCAST_API_KEY=

# TopHap public-records integration (MCP); off unless TOPHAP_ENABLED=1.
TOPHAP_ENABLED=0
TOPHAP_MCP_URL=
TOPHAP_ACCESS_TOKEN=
TOPHAP_REFRESH_TOKEN=
TOPHAP_TOKEN_EXPIRES_AT=
TOPHAP_TOKEN_ENDPOINT=
TOPHAP_CLIENT_ID=
TOPHAP_CLIENT_SECRET=
# OAuth redirect used by tools/tophap_oauth_setup.py (default: local callback).
TOPHAP_REDIRECT_URI=

# EchoWatch bridge (optional).
ECHOWATCH_URL=
ECHOWATCH_TOKEN=

# --- Dev / test tooling only ------------------------------------------
# Playwright: path to a Chromium binary, and the Python used to start the API.
CHROMIUM_PATH=
PYTHON=
